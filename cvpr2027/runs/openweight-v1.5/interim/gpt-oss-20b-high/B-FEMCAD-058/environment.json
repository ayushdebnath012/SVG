    "python_version": "3.12.15 | packaged by Anaconda, Inc. | (main, Oct  1 2026, 20:20:25) [GCC 14.3.0]",
    "commands": {
        "gmsh_coarse": "gmsh -3 -clscale 3 part.step -o mesh_coarse.msh -format msh2000",
