# encoding: utf-8
# 2021 R1
SetScriptVersion(Version="21.1.216")
system1 = GetSystem(Name="SYS")
engineeringData1 = system1.GetContainer(ComponentName="Engineering Data")
material1 = engineeringData1.GetMaterial(Name="Copper Alloy")
material1.DisplayName = "Copper Alloy-Chip, Processor"
material2 = engineeringData1.GetMaterial(Name="Silicon Anisotropic")
material2.DisplayName = "Silicon Anisotropic-Board"
material3 = engineeringData1.GetMaterial(Name="Aluminum Alloy")
material3.DisplayName = "Aluminum Alloy-Fins"
material4 = engineeringData1.GetMaterial(Name="Board")
material4.Delete()
material5 = engineeringData1.GetMaterial(Name="Chip")
material5.Delete()
material6 = engineeringData1.GetMaterial(Name="Fin")
material6.Delete()
material7 = engineeringData1.GetMaterial(Name="Processor")
material7.Delete()
system1.Refresh()
geometry1 = system1.GetContainer(ComponentName="Geometry")
geometry1.Edit()
geometry1.Exit()
model1 = system1.GetContainer(ComponentName="Model")
model1.Edit()
system2 = GetSystem(Name="SYS 2")
system2.Delete()
template1 = GetTemplate(
    TemplateName="Modal",
    Solver="ANSYS")
system3 = GetSystem(Name="SYS 1")
engineeringDataComponent1 = system3.GetComponent(Name="Engineering Data")
geometryComponent1 = system3.GetComponent(Name="Geometry")
modelComponent1 = system3.GetComponent(Name="Model")
solutionComponent1 = system3.GetComponent(Name="Solution")
componentTemplate1 = GetComponentTemplate(Name="SimulationSetupCellTemplate_StructuralModalANSYS")
system4 = GetSystem(Name="SYS 3")
system5 = template1.CreateSystem(
    ComponentsToShare=[engineeringDataComponent1, geometryComponent1, modelComponent1],
    DataTransferFrom=[Set(FromComponent=solutionComponent1, TransferName=None, ToComponentTemplate=componentTemplate1)],
    Position="Below",
    RelativeTo=system4)
system3.Update(AllDependencies=True)
system4.Update(AllDependencies=True)
system5.Update(AllDependencies=True)
model1.Exit()
Save(Overwrite=True)
