# encoding: utf-8
# 2025 R1
SetScriptVersion(Version="25.1.122")
template1 = GetTemplate(
    TemplateName="Static Structural",
    Solver="ANSYS")
system1 = GetSystem(Name="SYS")
system2 = template1.CreateSystem(
    Position="Below",
    RelativeTo=system1)
engineeringDataComponent1 = system2.GetComponent(Name="Engineering Data")
engineeringDataComponent2 = system1.GetComponent(Name="Engineering Data")
engineeringDataComponent1.ReplaceWithShare(
    TargetSystem=system2,
    ComponentToShare=engineeringDataComponent2,
    SourceSystem=system1)
geometryComponent1 = system2.GetComponent(Name="Geometry")
geometryComponent2 = system1.GetComponent(Name="Geometry")
geometryComponent1.ReplaceWithShare(
    TargetSystem=system2,
    ComponentToShare=geometryComponent2,
    SourceSystem=system1)
model1 = system1.GetContainer(ComponentName="Model")
model1.Edit()
model1.Exit()
Save(Overwrite=True)
results1 = system1.GetContainer(ComponentName="Results")
results1.Edit()
model1.Exit()
modelComponent1 = system2.GetComponent(Name="Model")
modelComponent1.Refresh()
model2 = system2.GetContainer(ComponentName="Model")
model2.Edit()
system3 = GetSystem(Name="SYS 1")
results2 = system3.GetContainer(ComponentName="Results")
results2.Edit()
model2.Exit()
model3 = system3.GetContainer(ComponentName="Model")
model3.Exit()
Save(Overwrite=True)
system1.DisplayText = "torsion"
system3.DisplayText = "static load"
system2.DisplayText = "lateral load transfer"
results3 = system2.GetContainer(ComponentName="Results")
results3.Edit()
results2.Edit()
model2.Exit()
model3.Exit()
Save(Overwrite=True)
Save(Overwrite=True)
