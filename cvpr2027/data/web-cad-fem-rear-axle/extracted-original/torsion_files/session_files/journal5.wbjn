# encoding: utf-8
# 2025 R1
SetScriptVersion(Version="25.1.122")
system1 = GetSystem(Name="SYS 2")
results1 = system1.GetContainer(ComponentName="Results")
results1.Edit()
system2 = GetSystem(Name="SYS")
results2 = system2.GetContainer(ComponentName="Results")
results2.Edit()
model1 = system2.GetContainer(ComponentName="Model")
model1.Exit()
results2.Edit()
Save(Overwrite=True)
model1.Exit()
model2 = system1.GetContainer(ComponentName="Model")
model2.Exit()
Save(Overwrite=True)
