# encoding: utf-8
# 2026 R1
SetScriptVersion(Version="26.1.174")
system1 = GetSystem(Name="SYS")
geometry1 = system1.GetContainer(ComponentName="Geometry")
geometry1.Edit(IsSpaceClaimGeometry=True)
geometry1.Edit(IsDiscoveryGeometry=True)
modelComponent1 = system1.GetComponent(Name="Model")
modelComponent1.Update(AllDependencies=True)
geometry1.Exit()
model1 = system1.GetContainer(ComponentName="Model")
model1.Edit()
system1.Copy(KeepConnections=True)
system2 = GetSystem(Name="SYS 1")
geometry2 = system2.GetContainer(ComponentName="Geometry")
geometry2.Edit(IsDiscoveryGeometry=True)
modelComponent2 = system2.GetComponent(Name="Model")
modelComponent2.Update(AllDependencies=True)
model2 = system2.GetContainer(ComponentName="Model")
model2.Edit()
geometry2.Exit()
modelComponent2.Update(AllDependencies=True)
geometry2.Edit(IsDiscoveryGeometry=True)
modelComponent2.Update(AllDependencies=True)
geometry2.Exit()
system1.DisplayText = "shared_topology"
system2.DisplayText = "contacts"
Save(Overwrite=True)
Save(Overwrite=True)
model1.Exit()
geometry2.Edit(IsDiscoveryGeometry=True)
geometry2.Exit()
geometry2.Edit()
Save(Overwrite=True)
