{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Joint CAD+FEM submission",
  "type": "object",
  "required": [
    "task_id",
    "artifacts",
    "lineage",
    "formulation",
    "units",
    "solver",
    "physical_regions",
    "reproduction_steps"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "pattern": "^FEMCAD-ADV-[0-9]{3}$"
    },
    "artifacts": {
      "type": "object",
      "required": [
        "cad_source",
        "cad",
        "mesh",
        "solver_input",
        "results",
        "solver_log"
      ],
      "properties": {
        "cad_source": {
          "type": "object",
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "cad": {
          "type": "object",
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "mesh": {
          "type": "object",
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "solver_input": {
          "type": "object",
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "results": {
          "type": "object",
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "solver_log": {
          "type": "object",
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        }
      }
    },
    "lineage": {
      "type": "object",
      "required": [
        "mesh_parent_cad_sha256",
        "solver_parent_mesh_sha256",
        "results_parent_solver_input_sha256"
      ],
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "formulation": {
      "enum": [
        "2d-plane-strain",
        "2d-plane-stress",
        "axisymmetric",
        "shell",
        "3d",
        "mixed"
      ]
    },
    "units": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string"
      }
    },
    "solver": {
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "physical_regions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "cad_entity_ids",
          "mesh_group_ids"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "cad_entity_ids": {
            "type": "array",
            "minItems": 1
          },
          "mesh_group_ids": {
            "type": "array",
            "minItems": 1
          }
        }
      }
    },
    "reproduction_steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$comment": "Candidate hash lineage is a declaration. Independent isolated replay and private task acceptance criteria are required for a joint pass."
}
