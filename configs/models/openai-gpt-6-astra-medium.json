{
  "adapter": "openai_compatible",
  "base_url": "https://api.openai.com/v1",
  "model": "gpt-6-astra",
  "api_key_env": "OPENAI_API_KEY",
  "temperature": null,
  "max_tokens_param": "max_completion_tokens",
  "max_tokens": 16000,
  "extra_body": {"reasoning_effort": "medium"},
  "json_mode": false,
  "timeout": 600
}
